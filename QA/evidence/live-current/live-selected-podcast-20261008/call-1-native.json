at narrative.\"\n    },\n    {\n      \"speaker\": \"host1\",\n      \"voice\": \"female\",\n      \"text\": \"Which is the perfect transition! If you are ready to elevate your brand and truly stand out, you should check out Fixture Media Co's services.\"\n    },\n    {\n      \"speaker\": \"host2\",\n      \"voice\": \"male\",\n      \"text\": \"For sure. Don't stay hidden in the dark. Visit Fixture Media Co to learn more and shine that spotlight on your business today!\"\n    }\n  ]\n}",
