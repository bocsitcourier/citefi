# ──────────────────────────────────────────────────────────────────
# Citefi — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────
# Neon (serverless Postgres) — used in development on Replit.
# On the DigitalOcean droplet this points to local Postgres instead:
#   DATABASE_URL=postgresql://citefi:<password>@localhost:5432/citefi
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require


# ── Auth / Sessions ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
SESSION_SECRET=<generate-a-random-256-bit-secret>


# ── AI providers ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...


# ── DigitalOcean Spaces (object storage for media / video) ────────
# Required for video generation (slideshow + Veo).
# Without these, all video generation jobs fail immediately with
# STORAGE_NOT_CONFIGURED rather than silently burning AI quota.
#
# How to get these:
#   1. Log in to DigitalOcean → Spaces → Create a Space.
#   2. Note the region (e.g. nyc3) and Space name (DO_SPACES_BUCKET).
#   3. Go to API → Spaces Keys → Generate new key.
#      Copy the Access Key (DO_SPACES_KEY) and Secret (DO_SPACES_SECRET).
#   4. The endpoint format is:
#      https://<region>.digitaloceanspaces.com
#      e.g. https://nyc3.digitaloceanspaces.com

DO_SPACES_KEY=<your-spaces-access-key>
DO_SPACES_SECRET=<your-spaces-secret-key>
DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
DO_SPACES_BUCKET=<your-space-name>

# Optional: CDN endpoint for serving uploaded assets publicly.
# If your Space has CDN enabled, set this to the CDN URL so video/image URLs
# are served from the edge instead of directly from Spaces.
# DO_SPACES_CDN_ENDPOINT=https://<space-name>.<region>.cdn.digitaloceanspaces.com


# ── Redis (BullMQ job queues) ─────────────────────────────────────
# On Replit: a local Redis daemon is auto-started — use the URL below.
# On the droplet: set this to your Redis server URL.
REDIS_URL=redis://127.0.0.1:6379


# ── Stripe (billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...


# ── Web search / intelligence ────────────────────────────────────
BRAVE_API_KEY=...


# ── GitHub integration ────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...


# ── Replit Object Storage (legacy — replaced by DO Spaces) ───────
# No longer used by the application. Only kept here for reference.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=<replit-bucket-id>
# PRIVATE_OBJECT_DIR=...
# PUBLIC_OBJECT_SEARCH_PATHS=...
